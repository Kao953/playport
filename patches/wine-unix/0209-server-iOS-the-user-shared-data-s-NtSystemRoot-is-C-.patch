From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: The Playport authors <dev@playport.dev>
Date: Mon, 9 Nov 2026 14:07:46 +0800
Subject: [PATCH] server: iOS: the user shared data's NtSystemRoot is
 C:\windows

Desktop Wine's wineboot fills KUSER_SHARED_DATA.NtSystemRoot at every
start (update_user_shared_data); the app never runs wineboot, so it was
empty. FINAL FANTASY RESONANCE DEMO builds the path of wintrust.dll from
it before Unreal starts, asked for "\System32\wintrust.dll" (c0000135),
and stopped on its own "failed to load SteamAPI" dialog.

Class: ios-port
Evidence: docs/decisions/0203-user-shared-data-names-the-windows-folder.md
Offered-upstream: no
---
 server/mapping.c | 12 +++++++++++-
 1 file changed, 11 insertions(+), 1 deletion(-)

diff --git a/server/mapping.c b/server/mapping.c
index 7446c706aec..bf4dde3f86c 100644
--- a/server/mapping.c
+++ b/server/mapping.c
@@ -1496,7 +1496,17 @@ struct object *create_user_data_mapping( struct object *root, struct unicode_str
 
     if (!(mapping = create_named_object( &params ))) return NULL;
     ptr = mmap( NULL, mapping->size, PROT_WRITE, MAP_SHARED, get_unix_fd( mapping->fd ), 0 );
-    if (ptr != MAP_FAILED) user_shared_data = ptr;
+    if (ptr != MAP_FAILED)
+    {
+        user_shared_data = ptr;
+#ifdef WINE_IOS
+        /* iOS: the app never runs wineboot, whose update_user_shared_data fills NtSystemRoot. */
+        {
+            static const WCHAR root[] = {'C',':','\\','w','i','n','d','o','w','s',0};
+            memcpy( user_shared_data->NtSystemRoot, root, sizeof(root) );
+        }
+#endif
+    }
     return &mapping->obj;
 }
 
